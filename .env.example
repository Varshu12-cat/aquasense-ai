# AquaSense AI Environment Configuration

# Application Mode: demo | production
APP_ENV=demo
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma separated; add your frontend origin without a trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Google Cloud Platform Configuration
GCP_PROJECT_ID=aquasense-ai-prod
GCP_REGION=us-central1
GCS_BUCKET_NAME=aquasense-ai-raw-telemetry
BIGQUERY_DATASET=aquasense_dw
BIGQUERY_TABLE=water_consumption_hourly
VERTEX_AI_ENDPOINT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Machine Learning Parameters
MODEL_STORAGE_PATH=./ml/models
DATA_PATH=./data/raw/campus_water_consumption_90days.csv
ISOLATION_FOREST_CONTAMINATION=0.015
DEFAULT_FORECAST_HORIZON_HOURS=24
